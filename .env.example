# Telegram Bot API Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control (ID пользователя Telegram, которому разрешен доступ к боту)
# Узнать свой ID можно через бота @userinfobot или @raw_data_bot
# Можно указать один ID:
ALLOWED_USER_ID=123456789
# Или список через запятую:
# ALLOWED_USER_IDS=123456789,987654321

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=60.0

# Prompt Configuration
SYSTEM_PROMPT=You are a helpful and concise AI assistant running locally via Ollama.
